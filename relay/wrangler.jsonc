{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maiky-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Workers AI always runs on Cloudflare, even under `wrangler dev` (needs `wrangler login`).
  "ai": {
    "binding": "AI"
  },
  // Text-to-speech: the VoiceStudio app on this machine. VOICESTUDIO_VOICE is "default"
  // (the engine picks a voice) or the id of a voice profile saved in VoiceStudio.
  "vars": {
    "VOICESTUDIO_URL": "http://127.0.0.1:3900",
    "VOICESTUDIO_VOICE": "default"
  }
  // RELAY_TOKEN: `.dev.vars` locally, `wrangler secret put RELAY_TOKEN` once deployed.
}
