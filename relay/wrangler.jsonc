{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maiky-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Workers AI always runs on Cloudflare, even under `wrangler dev` (needs `wrangler login`).
  "ai": {
    "binding": "AI"
  },
  // Text-to-speech: the Piper HTTP server on this machine. Use 127.0.0.1, not localhost:
  // on Windows localhost tries IPv6 first and adds ~2 s to every answer.
  "vars": {
    "PIPER_URL": "http://127.0.0.1:5000"
  }
  // RELAY_TOKEN: `.dev.vars` locally, `wrangler secret put RELAY_TOKEN` once deployed.
}
